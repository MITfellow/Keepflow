# Public site origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings > API).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend. Verify a sending domain before going live.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Rill <hello@yourdomain.com>"

# Admin access. Use a long, random value in production.
ADMIN_SECRET=

# Salt for hashing IP addresses used for rate limiting. Never reuse.
IP_HASH_SALT=

# Local development only. Production without Supabase refuses file storage
# unless WAITLIST_PREVIEW_STORE is explicitly set.
WAITLIST_ALLOW_FILE_STORE=true

# Ephemeral preview deployments only. Do not set this for a real launch.
# WAITLIST_PREVIEW_STORE=file
